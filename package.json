{
  "devDependencies": {
    "prettier": "^3.8.1"
  },
"scripts": {
  "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
  "setup": "npm --prefix packages/backend install",
  "build": "npm --prefix packages/backend run build",
  "start": "npm run build && cd packages/tui && go run .",
  "tui": "cd packages/tui && go run ."
}
}
